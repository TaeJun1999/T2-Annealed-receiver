+def v1_coverage(a):
+    """Frozen V1 queries only, with the runner's modulation, pilots, routing and RNG.
+
+    Legacy invocation above stays unchanged. No BLER is reported by this path.
+    Ratios use finite queries in each iteration as denominator; raw counts are saved.
+    """
+    import json
+    import torch
+    import runner as R
+    st = torch.load(a.stagec_ckpt, map_location="cpu", weights_only=False)
+    if st.get("testbed") != "D2" or st.get("prior") != a.prior:
+        raise ValueError("E5 coverage requires a D2 checkpoint trained on --prior")
+    _, grid = SG.load(st["testbed"], st.get("sigma_tag", ""))  # require the actual frozen grid
+    lo, hi = float(grid.min()), float(grid.max())
+    out = os.path.abspath(a.out)
+    if not out.endswith(".npz"):
+        raise ValueError("--out must end in .npz")
+    # Reserve both outputs before doing any receiver work; preserve all old artifacts.
+    with open(out, "xb") as raw, open(out[:-4] + ".json", "x") as summary:
+        R._init(a.tag)
+        values = {}
+        for snr in a.snr:
+            p = R.build_point("D2", a.cell, a.prior, snr, ntrain=a.ntrain,
+                              stagec_ckpt=a.stagec_ckpt, mod=a.mod)
+            rx = p["arms"]["M-ours-dscore-C-V1"]
+            if (rx.prior.s_lo, rx.prior.s_hi) != (lo, hi):
+                raise ValueError("V1 query range differs from the checkpoint's frozen training grid")
+            rng = C.trial_rng("D2", a.prior, p["Nr"], p["T"], p["Tp"], snr)
+            nu = []
+            for tr in range(a.skip0 + a.n):
+                H = p["gen"].sample(rng)
+                u = rng.integers(0, 2, p["code"].K)
+                perm = rng.permutation(p["code"].Ns)
+                _, Y = rx.transmit(u, perm, H, rng)
+                if tr >= a.skip0:
+                    nu.append(rx.run(Y, H, u, perm, C.N_ITER)["nu_q"])
+            values[f"{snr:g}|nu_q"] = nu = np.asarray(nu)
+            sg = np.sqrt(nu / 2)
+            fin = np.isfinite(sg)
+            below, above = (sg < lo) & fin, (sg > hi) & fin
+            counts = fin.sum(0)
+            frac = np.divide((below | above).sum(0), counts,
+                             out=np.full(C.N_ITER, np.nan), where=counts > 0)
+            for k, v in dict(sigma=sg, finite=counts, below=below.sum(0), above=above.sum(0),
+                             out_fraction=frac).items():
+                values[f"{snr:g}|{k}"] = v
+        meta = dict(modulation=a.mod, payload_bits=p["code"].K, protocol="E5-qam16-v1",
+                    checkpoint=a.stagec_ckpt, checkpoint_id=R.stagec_id_str(a.stagec_ckpt),
+                    fit_tag=a.tag, prior=a.prior, cell=a.cell, skip=a.skip0, n=a.n,
+                    sigma_tag=st.get("sigma_tag", ""), s_lo=lo, s_hi=hi,
+                    convention="sigma=sqrt(nu_q/2); per-iteration fraction among finite queries")
+        np.savez_compressed(raw, **values, **{f"meta|{k}": v for k, v in meta.items()})
+        detail = {k: np.asarray(v).tolist() for k, v in values.items()
+                  if k.endswith(("finite", "below", "above", "out_fraction"))}
+        json.dump(dict(meta=meta, iterations=detail), summary, indent=2)
+    print(f"[diag E5] saved V1 query coverage: mod={a.mod} K={p['code'].K} "
+          f"trials={a.skip0}..{a.skip0 + a.n - 1} -> {out}", flush=True)
+    return 0
+
+
 if __name__ == "__main__":
     sys.exit(main())
